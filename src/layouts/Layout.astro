---
import '@fontsource/orbitron/500.css';
import '@fontsource/orbitron/700.css';
import '@fontsource/orbitron/900.css';
import '@fontsource/share-tech-mono/400.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'SYNTHLINE — a retro synthwave arcade racer. Chase your ghost through neon canyons, skim traffic for boost. Playable on desktop and mobile.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site ?? new URL('https://shubhamtatvamasi.com')).origin;
const pageUrl = `${site}${base}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0221" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SYNTHLINE" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${pageUrl}og.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SYNTHLINE — a synthwave pseudo-3D arcade racer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${pageUrl}og.jpg`} />
    <meta name="twitter:image:alt" content="SYNTHLINE — a synthwave pseudo-3D arcade racer" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body>
    <noscript>
      <div class="noscript">
        SYNTHLINE is a canvas arcade racer and needs JavaScript. Please enable it
        and reload.
      </div>
    </noscript>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    height: 100dvh;
    background: #05010f;
    color: #efeaf6;
    overflow: hidden;
    overscroll-behavior: none;
    -webkit-text-size-adjust: 100%;
    font-family: 'Orbitron', 'Segoe UI', system-ui, sans-serif;
  }

  .noscript {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    font-family: 'Share Tech Mono', ui-monospace, monospace;
    font-size: 15px;
    line-height: 1.6;
    color: #ff2975;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
